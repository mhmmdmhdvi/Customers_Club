generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int     @id @default(autoincrement())
  phone     String  @unique
  firstName String?
  lastName  String?

  role Role @default(MEMBER)

  authSessions AuthSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  MEMBER
  ADMIN
}

model OTPCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// A verification proof is not an authenticated member session.
enum PhoneVerificationPurpose {
  REGISTER
  LOGIN
}

model PhoneVerification {
  id        Int                      @id @default(autoincrement())
  phone     String                   @db.VarChar(11)
  tokenHash String                   @unique @db.VarChar(64)
  purpose   PhoneVerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                 @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// Refresh rotation history is retained while its session is live for replay detection.
model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  version       Int            @default(0)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        Int         @id @default(autoincrement())
  tokenHash String      @unique @db.VarChar(64)
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  usedAt    DateTime?

  @@index([sessionId])
}
