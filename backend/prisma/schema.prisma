generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int     @id @default(autoincrement())
  phone     String  @unique
  firstName String?
  lastName  String?

  role Role @default(MEMBER)

  authSessions AuthSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  MEMBER
  ADMIN
}

model OTPCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  codeHash String? @db.VarChar(64)
  nonce String? @db.VarChar(64)
  failedAttempts Int @default(0)
  deliveryState String? @db.VarChar(12)

  @@index([phone, used, deliveryState, id])
}

model OtpRateBucket {
  key String @id @db.VarChar(64)
  events DateTime[] @default([])
  expiresAt DateTime

  @@index([expiresAt])
}

// A verification proof is not an authenticated member session.
enum PhoneVerificationPurpose {
  REGISTER
  LOGIN
}

model PhoneVerification {
  id        Int                      @id @default(autoincrement())
  phone     String                   @db.VarChar(11)
  tokenHash String                   @unique @db.VarChar(64)
  purpose   PhoneVerificationPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                 @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// Refresh rotation history is retained while its session is live for replay detection.
model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        Int
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  version       Int            @default(0)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        Int         @id @default(autoincrement())
  tokenHash String      @unique @db.VarChar(64)
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  usedAt    DateTime?

  @@index([sessionId])
}

enum ContactMessageSubject {
  SUPPORT
  SUGGESTION
  COMPLAINT
  OTHER
}

enum ContactMessageStatus {
  NEW
  READ
  RESOLVED
}

model ContactMessage {
  id        Int                   @id @default(autoincrement())
  name      String                @db.VarChar(80)
  phone     String                @db.VarChar(11)
  email     String?               @db.VarChar(254)
  subject   ContactMessageSubject
  message   String                @db.VarChar(250)
  status    ContactMessageStatus  @default(NEW)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([phone, createdAt])
}

enum AdminAuditOutcome {
  SUCCESS
  FAILURE
}

model AdminAuditEvent {
  id          Int               @id @default(autoincrement())
  actorUserId Int
  action      String            @db.VarChar(80)
  targetType  String            @db.VarChar(80)
  targetId    String            @db.VarChar(128)
  outcome     AdminAuditOutcome
  requestId   String?           @db.VarChar(128)
  details     Json?
  createdAt   DateTime          @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId, createdAt])
}

enum SecurityEventOutcome {
  SUCCESS
  FAILURE
}

model SecurityEvent {
  id          Int                  @id @default(autoincrement())
  eventType   String               @db.VarChar(80)
  outcome     SecurityEventOutcome
  actorUserId Int?
  requestId   String?              @db.VarChar(128)
  route       String               @db.VarChar(255)
  statusCode  Int
  details     Json?
  createdAt   DateTime             @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([outcome, createdAt])
  @@index([actorUserId, createdAt])
  @@index([statusCode, createdAt])
}