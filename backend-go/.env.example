# Go does not load .env: inject these variables through your process/secret store.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://customer_club_user:<url-encoded-password>@127.0.0.1:<explicit-port>/customer_club_db?sslmode=disable
ACCESS_TOKEN_SECRET=<independent-64-hex>
OTP_HMAC_SECRET=<different-independent-64-hex>
ADMIN_MFA_ENCRYPTION_KEY=<different-independent-64-hex>
JWT_ISSUER=customer-club
JWT_AUDIENCE=customer-club-browser
AUTH_ALLOWED_ORIGINS=http://localhost:5173
# Empty ignores all forwarding headers. Configure only your actual proxy peers.
TRUSTED_PROXY_CIDRS=
FARAZSMS_API_KEY=<provider-key>
FARAZSMS_LINE_NUMBER=<provider-line>
FARAZSMS_PATTERN_CODE=<provider-pattern>
